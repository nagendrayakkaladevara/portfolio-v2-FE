# Netlify → Site configuration → Environment variables → Import from .env
# Or: netlify env:import env.netlify.example
#
# Replace placeholder values, then import. Lines starting with # are ignored.
# Only VITE_* belong here — they are embedded in the client bundle (never secrets).
# API/database secrets live on the backend host (Vercel); set ALLOWED_ORIGINS there
# to this site’s HTTPS origin (no trailing slash).

# --- Production (phase 1): bundled Writing + demo chat; API URL ready for later ---
VITE_SITE_URL=https://sainagendrayakkaladevara.netlify.app
VITE_API_BASE_URL=https://portfolio-v2-be.vercel.app/api/v1
VITE_CONTENT_SOURCE=json
VITE_CHAT_SOURCE=demo

# --- Phase 2a: live Writing from Neon (after posts exist in the API) ---
# VITE_CONTENT_SOURCE=api

# --- Phase 2b: live AI chat (after backend implements streaming + enabled: true) ---
# VITE_CHAT_SOURCE=api